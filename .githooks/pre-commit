#!/usr/bin/env bash
set -e

# Validate modified Bash scripts and completions
changed_bash_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^completions/bash/|\.sh$' || true)
if [ -n "$changed_bash_files" ]; then
    echo "[pre-commit] Checking syntax of modified Bash scripts..."
    for file in $changed_bash_files; do
        if [ -f "$file" ]; then
            echo "  -> bash -o noexec $file"
            bash -o noexec "$file"
            if command -v shellcheck >/dev/null 2>&1; then
                echo "  -> shellcheck $file"
                shellcheck "$file"
            fi
        fi
    done
fi

# Validate modified Zsh completions (ShellCheck is Bash/POSIX only; Zsh uses zsh --noexec and compinit load)
changed_zsh_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^completions/zsh/|\.zsh$' || true)
if [ -n "$changed_zsh_files" ] && command -v zsh >/dev/null 2>&1; then
    echo "[pre-commit] Checking syntax of modified Zsh scripts..."
    for file in $changed_zsh_files; do
        if [ -f "$file" ]; then
            echo "  -> zsh --noexec $file"
            zsh --noexec "$file"
            echo "  -> zsh completion runtime load test: $file"
            zsh -f -c "autoload -Uz compinit && compinit -D -u && source $file"
        fi
    done
fi

# Validate modified UNIX manpages
changed_man_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^man/.*\.1$' || true)
if [ -n "$changed_man_files" ]; then
    echo "[pre-commit] Validating modified UNIX manpages..."
    for file in $changed_man_files; do
        if [ -f "$file" ]; then
            echo "  -> man -l $file"
            man -l "$file" > /dev/null
        fi
    done
fi

echo "[pre-commit] Running ruff lint check..."
ruff check .

echo "[pre-commit] Running ruff format check..."
ruff format --check .

if command -v pandoc >/dev/null 2>&1; then
    echo "[pre-commit] Validating manpage is up-to-date with Markdown source..."
    TMP_MAN=$(mktemp)
    pandoc man/dhcpt.1.md -s -t man -f markdown-smart -o "$TMP_MAN"
    if ! cmp -s man/dhcpt.1 "$TMP_MAN"; then
        echo "[ERROR] man/dhcpt.1 is out of date with man/dhcpt.1.md!" >&2
        echo "        Run 'make man' to recompile the manpage." >&2
        rm -f "$TMP_MAN"
        exit 1
    fi
    rm -f "$TMP_MAN"
fi

if command -v man >/dev/null 2>&1; then
    echo "[pre-commit] Validating manpage formatting..."
    man -l man/dhcpt.1 >/dev/null
fi

echo "[pre-commit] Running pytest test suite..."
PYTHONPATH=src pytest -q

echo "[pre-commit] All checks passed successfully!"
